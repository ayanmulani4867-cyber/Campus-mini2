# Campus Connect — Environment Variables
# Copy this file to .env and fill in your values.

# Database backend selection: 'firebase' (default) or 'postgres'
DATABASE_BACKEND=firebase

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://campus-mini2-default-rtdb.firebaseio.com/

# Firebase Service Account Credentials (either single-line JSON string or path to JSON file)
# Example JSON file path:
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Example JSON string (ideal for Render environment variable):
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# Legacy PostgreSQL URL (used only if DATABASE_BACKEND=postgres or running migration utility)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/campus_connect

# Flask App Secret
SECRET_KEY=change-me-to-a-random-secret
FLASK_ENV=development
CORS_ORIGINS=

# Optional: Override upload directory for study materials and submissions
# MATERIAL_UPLOAD_DIR=/path/to/uploads/materials